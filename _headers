# Cloudflare Pages response headers.
# HTML, scripts and styles are always re-checked with the server, so after an
# update every player gets the new version on the next visit (no stale cache).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache

# pictures rarely change: cache for a week
/assets/*
  Cache-Control: public, max-age=604800

# working files that don't need to be public
/tools/*
  X-Robots-Tag: noindex
/data/*
  X-Robots-Tag: noindex

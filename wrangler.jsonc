// Cloudflare Worker settings for whoisstrongest.com (deployed by "npx wrangler deploy").
{
  "name": "whoisstronger",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  // The whole project folder is the website; .assetsignore lists what is NOT uploaded.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Votes database (Cloudflare D1, tables from db/schema.sql).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whoisstrongest",
      "database_id": "0e261e79-a8d9-4369-9072-3e02655cf89f"
    }
  ],

  "observability": { "enabled": true }
}
